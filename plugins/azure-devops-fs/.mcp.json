{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "${AZURE_DEVOPS_ORG}"],
      "enabled": false,
      "env": {
        "AZURE_DEVOPS_PAT": "AZURE_DEVOPS_PAT"
      }
    }
  }
}
