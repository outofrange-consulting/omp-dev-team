# omp-dev-team — local model providers for Oh-My-Pi
# Copy to ~/.omp/agent/models.yml  (or merge into your existing one).
# Docs: https://github.com/can1357/oh-my-pi/blob/main/docs/models.md
#
# Tuned for: AMD 9950X (16c) + 64GB DDR5 + RTX 5070 Ti 16GB.
# Strategy: the SMALL tier runs locally; Sonnet/Opus stay on cloud.
#
# OMP AUTO-DISCOVERS Ollama on http://127.0.0.1:11434, so the default
# `ollama/qwen3-coder:30b` resolves with NO config once you've pulled it. You
# only need this file to pin a context window, use llama.cpp / LM Studio, or
# tune request compat. Pick the block matching your backend.

providers:
  # -------------------------------------------------------------------------
  # OLLAMA (default backend — ready to use)
  # Qwen3-Coder-30B-A3B: 30.5B total / ~3.3B active MoE. ~18GB on disk; does not
  # fully fit 16GB VRAM, but Ollama offloads the rest to your 64GB RAM and the
  # MoE keeps it fast. `ollama pull qwen3-coder:30b`
  # -------------------------------------------------------------------------
  ollama:
    baseUrl: http://127.0.0.1:11434
    api: openai-responses
    auth: none
    discovery:
      type: ollama
    models:
      - id: qwen3-coder:30b
        name: Qwen3-Coder 30B-A3B (local / small tier, recommended)
        reasoning: false
        input: [text]
        # 32k is comfortable; raise num_ctx in Ollama to match (see setup script).
        contextWindow: 32768
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
      # Throughput option — fits fully in 16GB VRAM, fastest for parallel review:
      - id: qwen2.5-coder:14b
        name: Qwen2.5-Coder 14B (local / fast, full-VRAM)
        reasoning: false
        input: [text]
        contextWindow: 32768
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
      - id: qwen2.5-coder:7b
        name: Qwen2.5-Coder 7B (local / max throughput)
        reasoning: false
        input: [text]
        contextWindow: 32768
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
      # Devstral Small 2 (Mistral, 24B dense, SWE-tuned) — ~14GB Q4, full-VRAM.
      # `ollama pull devstral` (or scripts/setup-local-models.sh --devstral)
      - id: devstral
        name: Devstral Small 2 24B (local / full-VRAM, SWE-tuned)
        reasoning: false
        input: [text]
        contextWindow: 32768
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }

  # -------------------------------------------------------------------------
  # LLAMA.CPP (max performance on the 30B-A3B)
  # Run a single-model server with MoE expert offload to CPU/RAM:
  #
  #   llama-server -hf unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_XL \
  #     -ngl 99 --n-cpu-moe 28 -c 32768 --host 127.0.0.1 --port 8080
  #
  # Lower --n-cpu-moe until VRAM is ~full (keeps more experts on GPU = faster),
  # or pin all experts to CPU with: -ot ".ffn_.*_exps.=CPU"
  # Then set modelRoles.smol: llama.cpp/qwen3-coder-30b-a3b
  # -------------------------------------------------------------------------
  llama.cpp:
    baseUrl: http://127.0.0.1:8080
    api: openai-responses
    auth: none
    discovery:
      type: llama.cpp
    models:
      - id: qwen3-coder-30b-a3b
        name: Qwen3-Coder 30B-A3B (llama.cpp, expert-offload)
        reasoning: false
        input: [text]
        contextWindow: 32768
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }
      # Qwen3-Coder-Next: 80B total / ~3B active MoE, hybrid DeltaNet+attention,
      # ~40GB Q4 (fits 64GB RAM). Best quality. Needs a recent llama.cpp build.
      # Serve: llama-server -hf unsloth/Qwen3-Coder-Next-GGUF:Q4_K_XL \
      #          -ngl 99 -ot ".ffn_.*_exps.=CPU" -c 32768 --port 8080
      - id: qwen3-coder-next
        name: Qwen3-Coder-Next 80B-A3B (llama.cpp, expert-offload)
        reasoning: false
        input: [text]
        contextWindow: 65536
        maxTokens: 8192
        cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }

  # -------------------------------------------------------------------------
  # LM STUDIO (GUI — uncomment to use)
  # Load the model, start the server, then set
  # modelRoles.smol -> lm-studio/<model-id-shown-in-LM-Studio>
  # -------------------------------------------------------------------------
  # lm-studio:
  #   baseUrl: http://127.0.0.1:1234/v1
  #   api: openai-completions
  #   auth: none
  #   discovery:
  #     type: lm-studio
